{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/apps.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/apps/produccion",
      "destination": "/apps/produccion/",
      "permanent": false
    },
    {
      "source": "/apps/cd",
      "destination": "/apps/cd/",
      "permanent": false
    },
    {
      "source": "/apps/desviaciones",
      "destination": "/apps/desviaciones/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/apps/produccion/",
      "destination": "https://calculoproduccion.vercel.app/"
    },
    {
      "source": "/apps/produccion/:path+",
      "destination": "https://calculoproduccion.vercel.app/:path+"
    },
    {
      "source": "/apps/cd/",
      "destination": "https://kurtbrinze.github.io/CD/"
    },
    {
      "source": "/apps/cd/:path+",
      "destination": "https://kurtbrinze.github.io/CD/:path+"
    },
    {
      "source": "/apps/desviaciones/",
      "destination": "https://kurtbrinze.github.io/Desviaciones/"
    },
    {
      "source": "/apps/desviaciones/:path+",
      "destination": "https://kurtbrinze.github.io/Desviaciones/:path+"
    }
  ]
}
